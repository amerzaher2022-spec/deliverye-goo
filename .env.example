# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgresql://dg:dg@localhost:5432/deliverygo
PORT=3000
# First administrator, created on startup if it does not exist (password: 12+ characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
# Enables the "reset demo data" button. Leave off for any deployment holding real data.
DEMO_MODE=true
# Seed the fictional demo businesses when the database is empty
SEED_ON_EMPTY=true
