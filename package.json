{
  "name": "erbil-delivery-world",
  "version": "0.1.0",
  "private": true,
  "description": "Erbil Delivery World — mobile-first 3D delivery game with a map-based merchant dashboard (investor demo)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/main.ts",
    "dev:web": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server/main.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx server/cli.ts migrate",
    "db:seed": "tsx server/cli.ts seed",
    "osm:fetch": "node scripts/fetch-osm.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "@fontsource/cairo": "^5.3.0",
    "fastify": "^5.12.6",
    "leaflet": "^1.9.4",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
